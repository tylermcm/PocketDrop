#include <windows.h>
#include "../core/version.h"

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PD_VERSION_NUM
PRODUCTVERSION PD_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "PocketDrop"
            VALUE "ProductName", "PocketDrop"
            VALUE "FileVersion", PD_VERSION
            VALUE "ProductVersion", PD_VERSION
            VALUE "OriginalFilename", "PocketDrop.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
